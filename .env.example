# ---------- Base de datos (docker compose) ----------
POSTGRES_USER=minigalu
POSTGRES_PASSWORD=minigalu
POSTGRES_DB=minigalu
POSTGRES_PORT=5433
DATABASE_URL=postgres://minigalu:minigalu@localhost:5433/minigalu

# ---------- API (apps/api) ----------
API_PORT=4000
# Origen de la web, para CORS
WEB_ORIGIN=http://localhost:3000
# Carpeta donde se guardan las imágenes subidas (puerto ImageStorage → disco local)
MEDIA_DIR=./storage/media

# ---------- Web (apps/web) ----------
# URL de la API vista desde el navegador y desde el servidor de Next
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------- Integraciones (fases siguientes; dejar vacías en local) ----------
# Mercado Pago (sandbox)
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Andreani (vacío = FakeAndreaniAdapter)
ANDREANI_USER=
ANDREANI_PASSWORD=
ANDREANI_CLIENT=
# Factura electrónica de ARCA (vacío = facturas simuladas, sin validez fiscal). Para probar con ARCA de verdad:
# certificado de homologación (WSASS) y ARCA_ENV=homologacion. CERT y KEY: el PEM en una línea (
) o la ruta al archivo
ARCA_ENV=homologacion
ARCA_CUIT=
ARCA_PUNTO_VENTA=
ARCA_CERT=
ARCA_KEY=
# Mail (Mailpit local)
SMTP_HOST=localhost
SMTP_PORT=1025
# Galú: ollama | claude
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
ANTHROPIC_API_KEY=
