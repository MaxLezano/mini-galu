# Producción en Lightsail: copiar a deploy/.env (nunca se commitea) y completar. Guía: docs/DEPLOY.md.
# La API lee todo este archivo; además, docker-compose.yml arma DATABASE_URL, PUBLIC_API_URL y WEB_ORIGIN.

# ---------- Dominio ----------
WEB_HOST=minigalu.com.ar
API_HOST=api.minigalu.com.ar
# misma cookie de sesión para la tienda y la API
COOKIE_DOMAIN=minigalu.com.ar
# cuenta de Let's Encrypt (avisa si un certificado no se puede renovar)
ACME_EMAIL=

# ---------- Disco aparte (Lightsail block storage, montado por deploy/bootstrap.sh) ----------
DATA_DIR=/mnt/data

# ---------- Base ----------
POSTGRES_USER=minigalu
# generala con: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=minigalu

# ---------- Backups (bucket PRIVADO de Lightsail; nunca el mismo de las fotos) ----------
AWS_REGION=sa-east-1
BACKUP_BUCKET=
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
# días que se puede volver atrás (copia continua) y copias diarias que se guardan
BACKUP_KEEP_DAYS=30
DUMP_KEEP_DAYS=30

# ---------- Avisos (servidor caído, backup fallido, disco lleno) ----------
# uno o varios mails separados por coma
ALERT_EMAIL=

# ---------- Mails (Amazon SES por SMTP: los de la tienda y los avisos) ----------
SMTP_HOST=email-smtp.sa-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Mini Galú <hola@minigalu.com.ar>

# ---------- Fotos (bucket PÚBLICO de Lightsail) ----------
S3_ENDPOINT=https://s3.sa-east-1.amazonaws.com
S3_REGION=sa-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# https://<bucket>.s3.sa-east-1.amazonaws.com (o el dominio de la distribución si se agrega una)
MEDIA_PUBLIC_URL=

# ---------- Sesiones ----------
# generalo con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# ---------- Mercado Pago (credenciales de PRODUCCIÓN) ----------
MP_MODE=produccion
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# ---------- Opcionales ----------
# Andreani: sin las cinco, en producción no se ofrece Andreani (los demás envíos siguen)
ANDREANI_ENV=produccion
ANDREANI_USER=
ANDREANI_PASSWORD=
ANDREANI_CLIENT=
ANDREANI_CONTRACT_DOMICILIO=
ANDREANI_CONTRACT_SUCURSAL=
# Factura electrónica (ARCA, paso 9 de docs/DEPLOY.md): sin las cuatro, los pedidos quedan sin facturar y el panel avisa
ARCA_ENV=produccion
ARCA_CUIT=
ARCA_PUNTO_VENTA=
ARCA_CERT=
ARCA_KEY=
# "Continuar con Google"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Galú con IA (sin clave responde por reglas)
ANTHROPIC_API_KEY=
