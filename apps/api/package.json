{
  "name": "@mini-galu/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "node build.mjs",
    "start": "node --enable-source-maps dist/main.js",
    "migrate": "node dist/migrate.js",
    "admin": "node dist/admin.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "andreani:check": "tsx src/scripts/andreani-check.ts",
    "media:upload": "tsx src/scripts/media-upload.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@hono/node-server": "^2.1.3",
    "@mini-galu/contracts": "workspace:*",
    "@mini-galu/db": "workspace:*",
    "better-auth": "^1.7.7",
    "hono": "^4.13.13",
    "node-forge": "1.3.1",
    "nodemailer": "^10.0.15",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "sharp": "0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@mini-galu/config": "workspace:*",
    "@types/node": "^24.19.1",
    "@types/node-forge": "1.3.11",
    "@types/qrcode": "1.5.5",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
